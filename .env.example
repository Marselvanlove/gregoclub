# ===========================================
# Telegram Bot
# ===========================================
BOT_TOKEN=your-telegram-bot-token
BOT_USERNAME=your_bot_username
ADMIN_ID=123456789
CHANNEL_ID=-1001234567890

# ===========================================
# FastAPI / Uvicorn
# ===========================================
WEB_HOST=0.0.0.0
WEB_PORT=8000
LOG_LEVEL=INFO
WEBHOOK_PUBLIC_URL=https://your-bot-domain.example.com

# ===========================================
# Database
# Managed Postgres is required for shared bot + dashboard analytics.
# Example for Neon:
# postgresql+asyncpg://user:password@ep-xxx.eu-central-1.aws.neon.tech/dbname?sslmode=require
# ===========================================
DATABASE_URL=postgresql+asyncpg://user:password@host/database?sslmode=require

# ===========================================
# Stripe
# ===========================================
STRIPE_SECRET_KEY=sk_live_or_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_live_or_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_1_MONTH=price_xxx
STRIPE_PRICE_3_MONTHS=price_xxx
STRIPE_PRICE_6_MONTHS=price_xxx

# ===========================================
# Tariffs
